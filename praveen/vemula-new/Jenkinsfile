pipeline {
    agent any

    tools {
        jdk 'Java21'
        maven 'Maven'
    }
stages {
	stage('Checkout') {
		steps {
			git branch: 'main',
			url:' https://github.com/vemula2448/second_Testing.git'
							}
						}
	stage('Build') {
		steps {
			dir('praveen/vemula-new') {
            bat 'mvn clean package'
        }
    }
}
	stage('Archive WAR') {
		steps {
			archiveArtifacts artifacts: 'vemula-new/target/*.war'
			}
		}
	}
}